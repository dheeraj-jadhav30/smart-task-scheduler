{
  "info": {
    "_postman_id": "7b8d1c23-4567-89ab-cdef-0123456789ab",
    "name": "Smart Task Scheduler & Reminder System API",
    "description": "Comprehensive Postman collection for testing the Smart Task Scheduler and Asynchronous BullMQ Reminder Engine.\n\n### Features:\n- Automated JWT token extraction on Login\n- Dynamic future timestamp generation for delayed reminders\n- Full CRUD operations with filtering and pagination\n- Operational health checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "Liveness Probe (GET /health/live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            },
            "description": "Verifies that the Express process is active and responsive."
          },
          "response": []
        },
        {
          "name": "Readiness Probe (GET /health/ready)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Pings both MongoDB and Redis to ensure required infrastructure dependencies are connected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('authToken', json.token);",
                  "        console.log('✅ AuthToken saved to collection variables.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user and returns a signed JWT."
          },
          "response": []
        },
        {
          "name": "Login User (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('authToken', json.token);",
                  "        console.log('✅ AuthToken automatically updated for all task requests.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user credentials and automatically stores the JWT token in collection variable {{authToken}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Tasks & Reminders",
      "item": [
        {
          "name": "Create Task (No Reminder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('taskId', json.data._id);",
                  "        console.log('✅ Saved taskId:', json.data._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Read System Design Primer\",\n  \"description\": \"Study distributed caching and queue patterns\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"2026-10-30T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/task/create-task",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "create-task"]
            },
            "description": "Creates a task without a background reminder."
          },
          "response": []
        },
        {
          "name": "Create Task (With Automated 30s Delayed Reminder)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Auto-calculate exact future timestamp 30 seconds from now",
                  "var futureTimestamp = new Date(Date.now() + 30000).toISOString();",
                  "pm.variables.set('autoFutureReminder', futureTimestamp);",
                  "console.log('⏰ Auto-generated reminderAt:', futureTimestamp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('taskId', json.data._id);",
                  "        console.log('✅ Task with reminder created. ID:', json.data._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Live BullMQ Reminder Demo\",\n  \"description\": \"Watch the worker terminal wake up in 30 seconds!\",\n  \"priority\": \"high\",\n  \"reminderAt\": \"{{autoFutureReminder}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/task/create-task",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "create-task"]
            },
            "description": "Uses a Postman Pre-request script to automatically compute a reminder 30 seconds into the future. Schedules a BullMQ job in Redis."
          },
          "response": []
        },
        {
          "name": "Get Tasks (Paginated: Page 1, Limit 5)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/task/get-tasks?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "get-tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Lists paginated tasks owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "Get Tasks (Filter: Priority = high)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/task/get-tasks?priority=high",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "get-tasks"],
              "query": [
                {
                  "key": "priority",
                  "value": "high"
                }
              ]
            },
            "description": "Filters user tasks by high priority."
          },
          "response": []
        },
        {
          "name": "Get Tasks (Filter: Status = completed)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/task/get-tasks?status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "get-tasks"],
              "query": [
                {
                  "key": "status",
                  "value": "completed"
                }
              ]
            },
            "description": "Filters user tasks by completed status."
          },
          "response": []
        },
        {
          "name": "Get Task By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/task/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "{{taskId}}"]
            },
            "description": "Fetches authoritative details of a single task."
          },
          "response": []
        },
        {
          "name": "Update Task (Reschedule Reminder)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var rescheduleTime = new Date(Date.now() + 60000).toISOString();",
                  "pm.variables.set('rescheduleTime', rescheduleTime);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Task Title\",\n  \"priority\": \"high\",\n  \"reminderAt\": \"{{rescheduleTime}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/task/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "{{taskId}}"]
            },
            "description": "Updates task fields and bumps reminderVersion to invalidate the old Redis job."
          },
          "response": []
        },
        {
          "name": "Complete Task (Cancels Reminder)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/task/{{taskId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "{{taskId}}", "complete"]
            },
            "description": "Marks task status as completed and removes pending job from BullMQ."
          },
          "response": []
        },
        {
          "name": "Delete Task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/task/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "task", "{{taskId}}"]
            },
            "description": "Deletes task and purges its scheduled alarm from Redis."
          },
          "response": []
        }
      ]
    }
  ]
}
